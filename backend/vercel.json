{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "prisma generate",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "src/**,prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}